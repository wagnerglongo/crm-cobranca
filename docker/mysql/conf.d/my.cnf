[mysqld]
# Rede / charset
bind-address=0.0.0.0
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-time-zone=-03:00
skip-name-resolve

# InnoDB leve para DEV em maquina de 8 GB RAM
innodb_buffer_pool_size=1024M
innodb_log_file_size=256M
innodb_flush_log_at_trx_commit=2
innodb_flush_method=O_DIRECT
innodb_file_per_table=1
# Ajuste de memoria (2026-10-06): o MySQL chegava a 1,9GB RAM + 1,6GB swap no
# limite de 2GB do container. Pico real de conexoes = 10 (php-fpm abre no
# maximo 8); max_connections e table_open_cache tambem dimensionam o
# performance_schema (247MB medidos).
max_connections=40
table_open_cache=512
innodb_log_buffer_size=16M
# performance_schema fica ligado (scripts/medir-memoria-mysql.sh usa), mas
# com historicos menores.
performance_schema_digests_size=2000
performance_schema_events_statements_history_long_size=1000
performance_schema_events_stages_history_long_size=1000
performance_schema_events_waits_history_long_size=1000
performance_schema_events_transactions_history_long_size=1000
tmp_table_size=64M
max_heap_table_size=64M
sort_buffer_size=2M
join_buffer_size=2M
read_buffer_size=1M
read_rnd_buffer_size=2M

# Arquivos grandes / cargas
local_infile=1
max_allowed_packet=256M
net_read_timeout=600
net_write_timeout=600
wait_timeout=28800
interactive_timeout=28800

# Binlog preparado para Debezium CDC
server-id=1
log_bin=mysql-bin
binlog_format=ROW
binlog_row_image=FULL
binlog_expire_logs_seconds=345600
# O MySQL exige a consistencia GTID ativa antes de habilitar o modo GTID.
enforce_gtid_consistency=ON
gtid_mode=ON
log_replica_updates=ON
sync_binlog=1

# Logs
log_error=/var/lib/mysql/mysql-error.log
slow_query_log=1
slow_query_log_file=/var/lib/mysql/mysql-slow.log
long_query_time=2

[client]
default-character-set=utf8mb4
