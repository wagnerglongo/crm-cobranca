<clickhouse>
    <logger>
        <level>warning</level>
    </logger>

    <!--
      O container possui limite de 768 MiB. Reserva 128 MiB para memoria nao
      rastreada pelo ClickHouse e permite ate 640 MiB ao servidor. Os caches
      menores evitam disputar memoria com DDL, INSERT e consultas de status.
    -->
    <max_server_memory_usage>671088640</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>33554432</uncompressed_cache_size>

    <!--
      Em VMs pequenas, os logs internos criam parts continuamente. Quando um
      merge falha por memoria, error_log registra a falha e gera ainda mais
      parts, formando um ciclo de CPU e memoria. O CRM possui monitoramento em
      Redis e nos logs dos containers, portanto estas tabelas diagnosticas nao
      sao necessarias neste perfil.
    -->
    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <session_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <crash_log remove="1"/>
    <error_log remove="1"/>
    <processors_profile_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <zookeeper_log remove="1"/>
    <filesystem_cache_log remove="1"/>
    <filesystem_read_prefetches_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <transactions_info_log remove="1"/>
    <backup_log remove="1"/>
</clickhouse>
