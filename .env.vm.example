# CRM Call Center - modelo para VM Linux
APP_NAME="CRM Call Center"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

COMPOSE_PROJECT_NAME=crm-dev
HOST_UID=1000
HOST_GID=1000

# MySQL
MYSQL_VERSION=8.4
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=crm_dev
MYSQL_USER=crm_app
MYSQL_PASSWORD=troque_esta_senha_app
MYSQL_PORT=3307

MYSQL_DEBEZIUM_USER=debezium
MYSQL_DEBEZIUM_PASSWORD=troque_esta_senha_debezium

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm_dev
DB_USERNAME=crm_app
DB_PASSWORD=troque_esta_senha_app

# Redis
REDIS_VERSION=8.4-alpine
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=troque_esta_senha_redis_cache
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=troque_esta_senha_redis_queue
REDIS_CACHE_DATABASE=0
REDIS_QUEUE_DATABASE=0
REDIS_SESSION_ENABLED=true
REDIS_SESSION_DATABASE=1

# OpenSearch
OPENSEARCH_VERSION=3.7.0
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_DASHBOARDS_INTERNAL_URL=http://opensearch-dashboards:5601
OPENSEARCH_INITIAL_ADMIN_PASSWORD=TroqueEstaSenha123!
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_CONTRATOS_INDEX=crm_contratos_v1
OPENSEARCH_CLIENTES_INDEX=crm_clientes_v1
OPENSEARCH_ACORDOS_INDEX=crm_acordos_v1
OPENSEARCH_PREVENTIVA_INDEX=crm_preventiva_v1
OPENSEARCH_ACIONAMENTOS_INDEX=crm_acionamentos_v1
OPENSEARCH_ESTRATEGIAS_INDEX=crm_estrategias_resultados_v1

# ClickHouse - portas originais
CLICKHOUSE_VERSION=26.3
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=crm_analytics_dev
CLICKHOUSE_USER=crm_app
CLICKHOUSE_PASSWORD=troque_esta_senha_clickhouse

# Redpanda / Kafka
REDPANDA_VERSION=v26.1.10
KAFKA_BROKERS=redpanda:9092
CDC_CONSUMER_GROUP=crm-cdc-projection-v1
CDC_BATCH_SIZE=250
CDC_BATCH_WAIT_MS=500
KAFKA_EXTERNAL_BROKERS=localhost:19092
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PANDAPROXY_PORT=18082
REDPANDA_ADMIN_PORT=9644

# Debezium
DEBEZIUM_VERSION=3.5.2.Final
DEBEZIUM_PORT=8083
DEBEZIUM_GROUP_ID=crm-debezium-dev
DEBEZIUM_TOPIC_PREFIX=crm.mysql
DEBEZIUM_TABLE_INCLUDE_LIST=pessoas,pessoa_contatos,pessoa_enderecos,contratos,contrato_parcelas,atendimentos_historico,atendimento_resultados,campanhas,campanha_itens,estrategias,estrategia_contratos,acordos_operacionais,acordos_operacionais_parcelas,acordos_operacionais_acompanhamento,acordo_regras_carencia,usuarios,pagamentos,boletos,baixas,cargas_arquivos

# Storage
STORAGE_DISK=local
STORAGE_LOCAL_PATH=/var/www/storage
STORAGE_CARGAS_PATH=/var/www/storage/cargas
STORAGE_ANEXOS_PATH=/var/www/storage/anexos

# Cargas
CARGAS_BATCH_SIZE=5000
CARGAS_HASH_ALGO=sha256
CARGAS_DEFAULT_ENCODING=utf-8-sig

# Integracao ACME (preencha na VM; nao coloque segredos no Git)
ACME_API_BASE_URL=http://credor-simulado:8080
ACME_API_TOKEN_BASE_URL=http://credor-simulado:8080
ACME_API_USERNAME=
ACME_API_PASSWORD=
ACME_API_TIMEOUT=45
ACME_API_ACTION_HISTORY_CACHE_SECONDS=600
ACME_API_AGREEMENT_CACHE_SECONDS=600

# Worker de integracoes externas (outbox)
INTEGRATION_WORKER_BATCH=50
INTEGRATION_WORKER_POLL_SECONDS=2
INTEGRATION_WORKER_LOCK_SECONDS=300
INTEGRATION_WORKER_HEARTBEAT_TTL=300
INTEGRATION_WORKER_HEARTBEAT_INTERVAL=15

# Exportacoes CSV
RELATORIOS_CSV_MAX_DIAS=366
RELATORIOS_CSV_MAX_LINHAS=200000
DADOS_GERAIS_CSV_MAX_LINHAS=1000000

# API corporativa (token único com expiração)
API_DOCS_ENABLED=true
API_DOCS_REQUIRE_LOGIN=false
API_ACCESS_TOKEN_TTL=1800
API_MAX_JSON_BYTES=65536
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW=60
API_AUTH_RATE_LIMIT_REQUESTS=10
API_AUTH_RATE_LIMIT_WINDOW=60
# Endpoint legado de relatorio CSV (public/operacao/api/relatorios), por token.
RELATORIO_API_RATE_LIMIT_REQUESTS=30
RELATORIO_API_RATE_LIMIT_WINDOW=60
# Same-origin funciona com a lista vazia. Inclua aqui apenas origens HTTPS autorizadas.
API_CORS_ALLOWED_ORIGINS=
# Informe o IP do proxy somente se ele controlar X-Forwarded-For.
API_TRUSTED_PROXIES=

# Alertas por email (falha de carga/aplicacao). SMTP_PASSWORD vazio = alerta desativado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=troque_esta_senha_smtp
SMTP_FROM=
SMTP_FROM_NOME=CRM Pactua - Alertas
ALERTA_EMAIL_DESTINO=
