# Pactua CRM - exemplo local. Copie para .env.local e preencha segredos localmente.
APP_NAME=Pactua
APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
COMPOSE_PROJECT_NAME=crm-dev
HOST_UID=1000
HOST_GID=1000

MYSQL_VERSION=8.4
MYSQL_ROOT_PASSWORD=ALTERE_AQUI
MYSQL_DATABASE=crm_dev
MYSQL_USER=crm_app
MYSQL_PASSWORD=ALTERE_AQUI
MYSQL_PORT=3307
MYSQL_DEBEZIUM_USER=debezium
MYSQL_DEBEZIUM_PASSWORD=ALTERE_AQUI
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm_dev
DB_USERNAME=crm_app
DB_PASSWORD=ALTERE_AQUI

REDIS_VERSION=8.4-alpine
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=ALTERE_AQUI
REDIS_CACHE_DB=0
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=ALTERE_AQUI
REDIS_QUEUE_DB=0
REDIS_CONNECT_TIMEOUT=0.8
REDIS_READ_TIMEOUT=0.8
REDIS_CACHE_PREFIX=works:
REDIS_CREDOR_CONFIG_TTL=300

OPENSEARCH_VERSION=3.7.0
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ALTERE_AQUI
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

CLICKHOUSE_VERSION=26.3
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=crm_analytics_dev
CLICKHOUSE_USER=crm_app
CLICKHOUSE_PASSWORD=ALTERE_AQUI

REDPANDA_VERSION=v26.1.10
KAFKA_BROKERS=redpanda:9092
KAFKA_EXTERNAL_BROKERS=localhost:19092
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PANDAPROXY_PORT=18082
REDPANDA_ADMIN_PORT=9644
REDPANDA_ADMIN_HOST=redpanda
REDPANDA_ADMIN_INTERNAL_PORT=9644

DEBEZIUM_VERSION=3.5.2.Final
DEBEZIUM_HOST=debezium
DEBEZIUM_PORT=8083
DEBEZIUM_GROUP_ID=crm-debezium-dev

STORAGE_DISK=local
STORAGE_LOCAL_PATH=/var/www/storage
STORAGE_CARGAS_PATH=/var/www/storage/cargas
STORAGE_ANEXOS_PATH=/var/www/storage/anexos
CARGAS_BATCH_SIZE=5000
CARGAS_HASH_ALGO=sha256
CARGAS_DEFAULT_ENCODING=UTF-8

ACME_API_BASE_URL=http://credor-simulado:8080
ACME_API_TOKEN_BASE_URL=http://credor-simulado:8080
ACME_API_USERNAME=demo
ACME_API_PASSWORD=demo
ACME_API_TIMEOUT=45
ACME_API_STRUCTURED_LOG_MAX_BYTES=5242880
ACME_API_ACTION_HISTORY_CACHE_SECONDS=600
ACME_API_AGREEMENT_CACHE_SECONDS=600

# Worker de integracoes externas (outbox)
INTEGRATION_WORKER_BATCH=50
INTEGRATION_WORKER_POLL_SECONDS=2
INTEGRATION_WORKER_LOCK_SECONDS=300
INTEGRATION_WORKER_HEARTBEAT_TTL=300
INTEGRATION_WORKER_HEARTBEAT_INTERVAL=15

RELATORIOS_CSV_MAX_DIAS=366
RELATORIOS_CSV_MAX_LINHAS=200000
DADOS_GERAIS_CSV_MAX_LINHAS=1000000

# API corporativa (token único com expiração)
API_DOCS_ENABLED=true
API_DOCS_REQUIRE_LOGIN=false
API_ACCESS_TOKEN_TTL=1800
API_MAX_JSON_BYTES=65536
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW=60
API_AUTH_RATE_LIMIT_REQUESTS=10
API_AUTH_RATE_LIMIT_WINDOW=60
# Endpoint legado de relatorio CSV (public/operacao/api/relatorios), por token.
RELATORIO_API_RATE_LIMIT_REQUESTS=30
RELATORIO_API_RATE_LIMIT_WINDOW=60
# Vazio permite apenas same-origin. Separe origens adicionais por virgula.
API_CORS_ALLOWED_ORIGINS=http://localhost:8080
# Liste somente IPs de proxies realmente confiaveis; vazio usa REMOTE_ADDR.
API_TRUSTED_PROXIES=

# Alertas por email (falha de carga/aplicacao). SMTP_PASSWORD vazio = alerta desativado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=ALTERE_AQUI
SMTP_FROM=
SMTP_FROM_NOME=CRM Pactua - Alertas
ALERTA_EMAIL_DESTINO=
